APP_ENV=local
APP_NAME=nyc-housing-rag
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://nyc_housing:nyc_housing@localhost:5432/nyc_housing
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
HEALTHCHECK_TIMEOUT_SECONDS=2
SESSION_COOKIE_NAME=nyc_housing_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=12
PASSWORD_MIN_LENGTH=12
ARTIFACT_STORAGE_BACKEND=local
ARTIFACT_STORAGE_PATH=.artifacts
ARTIFACT_S3_BUCKET=
ARTIFACT_S3_PREFIX=
ARTIFACT_S3_REGION=
ARTIFACT_S3_ENDPOINT_URL=
ARTIFACT_S3_ACCESS_KEY_ID=
ARTIFACT_S3_SECRET_ACCESS_KEY=
INGESTION_HTTP_TIMEOUT_SECONDS=30
INGESTION_HTTP_MAX_RETRIES=2
INGESTION_USER_AGENT=nyc-housing-rag-mvp/0.1
HPD_VIOLATIONS_LIMIT=5000
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=fake-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_DIMENSION=16
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=2
SEARCH_DEFAULT_LIMIT=10
SEARCH_MAX_LIMIT=25
SEARCH_VECTOR_WEIGHT=0.45
SEARCH_KEYWORD_WEIGHT=0.35
SEARCH_CITATION_WEIGHT=1.0
ANSWER_LLM_PROVIDER=fake
ANSWER_LLM_MODEL=fake-answer-small
ANSWER_LLM_API_KEY=
ANSWER_LLM_BASE_URL=https://api.openai.com/v1
ANSWER_LLM_TIMEOUT_SECONDS=60
ANSWER_LLM_MAX_RETRIES=1
ANSWER_MAX_CONTEXT_CHUNKS=8
ANSWER_MAX_CONTEXT_CHARS=16000
ANSWER_MAX_OUTPUT_TOKENS=900
ANSWER_TEMPERATURE=0
ANSWER_INCLUDE_SOURCE_COVERAGE=true
RATE_LIMIT_ENABLED=true
LOGIN_FAILED_LIMIT=5
LOGIN_FAILED_WINDOW_SECONDS=900
LOGIN_COOLDOWN_SECONDS=900
SEARCH_REQUESTS_PER_HOUR=120
ANSWER_REQUESTS_PER_HOUR=30
USER_DAILY_LLM_TOKEN_BUDGET=30000
MAX_REQUEST_BODY_BYTES=65536
SEARCH_TIMEOUT_SECONDS=10
ANSWER_TIMEOUT_SECONDS=30
RATE_LIMIT_EVENT_RETENTION_DAYS=30
ALLOW_FAKE_PROVIDERS_IN_PRODUCTION=false
